# --- required ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small
# Hosted URLs (postgres:// or postgresql://) are accepted; the asyncpg driver is added for you.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dochat
# Comma-separated list of browser origins allowed to call the API (your frontend URLs).
ALLOW_ORIGINS=http://localhost:3000

# --- optional (defaults shown) ---
# OPENAI_TEMPERATURE=0.2          # low = repeatable answers for grounded Q&A
# CHROMA_PATH=./chroma_db         # on a host, point this at a persistent volume (e.g. /data/chroma)
# CHUNK_SIZE=500                  # chosen with evals/retrieval_sweep.py
# CHUNK_OVERLAP=150
# MAX_UPLOAD_MB=10
# RETRIEVAL_TOP_K=4
# RETRIEVAL_MAX_DISTANCE=         # unset = off (a distance cutoff hurt recall in the sweep)
# SUMMARY_MAX_CHUNKS=24
# HISTORY_TOKEN_BUDGET=6000
